# Dependencies
node_modules/
.next/
out/
build/
dist/

# Secrets — never commit
.env
.env.*
!.env.example

# Runtime logs
*.log
start.log
start.err.log

# Local data / databases
*.db
*.sqlite
*.sqlite3
data/
.next/standalone/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Build artifacts
*.tsbuildinfo
coverage/

# Lockfile is intentionally not committed.
#
# AgentFlow's CLI has zero runtime dependencies, so a lockfile carries no
# reproducibility benefit. Committing one here is actively harmful: this
# working tree contains a 9Router Next.js build under .next/standalone/ whose
# package.json pulls 590 packages into any lockfile npm generates, which would
# make `npm install` in CI try to install all of them.
package-lock.json
npm-shrinkwrap.json