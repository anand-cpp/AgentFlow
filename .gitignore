# Dependencies
node_modules/
.next/
out/
build/
# Rooted so it ignores the build output at the repo root only, not the
# test/dist/ directory that holds distribution-integrity tests.
/dist/

# Secrets — never commit
.env
.env.*
!.env.example

# Runtime logs
*.log
start.log
start.err.log

# Local data / databases
*.db
*.sqlite
*.sqlite3
data/
.next/standalone/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Build artifacts
*.tsbuildinfo
coverage/

# Lockfile is committed.
#
# The CLI has zero runtime dependencies, but dev tooling (eslint, typescript)
# is pinned via package-lock.json so `npm ci` installs an identical tree in CI.
# npm resolves only the root package here -- there are no workspaces -- so the
# 9Router Next.js build under .next/standalone/ is NOT pulled into the lockfile
# (verified: ~87 entries, none under .next). Re-check that size before ever
# re-adding a lockfile ignore rule.
npm-shrinkwrap.json
# Archived audit reports (point-in-time)
docs/audits/

.gitattributes


# Repository map cache (derived data, rebuilt on demand; config like
# .agentflow/mcp.json is still committed)
.agentflow/repo-map.json
